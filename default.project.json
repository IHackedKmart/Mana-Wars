{
  "name": "ManaWars",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 60,
        "CharacterWalkSpeed": 16
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false,
        "RespawnTime": 4
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 14.5,
        "Brightness": 2.5,
        "GlobalShadows": true,
        "OutdoorAmbient": [
          0.5,
          0.5,
          0.55
        ],
        "Ambient": [
          0.27,
          0.27,
          0.32
        ]
      }
    },
    "Workspace": {
      "$properties": {
        "FallenPartsDestroyHeight": -150,
        "StreamingEnabled": false
      }
    },
    "TextChatService": {
      "$properties": {
        "ChatVersion": "TextChatService"
      }
    }
  }
}
